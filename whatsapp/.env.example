# Copia este archivo a .env y complétalo cuando tengas la cuenta de Meta lista.
# Sin estas variables el servidor arranca igual, en modo DRY_RUN: procesa la
# conversación normal pero nunca llama a la API real de Meta.

# Token temporal (24h) del Playground de Meta, o token permanente de un System User
WHATSAPP_TOKEN=

# En WhatsApp Manager > Números de teléfono > tu número de prueba
PHONE_NUMBER_ID=

# Cualquier cadena que tú inventes — la escribes también al configurar el
# webhook en Meta ("Verify token"). Debe coincidir en ambos lados.
VERIFY_TOKEN=allpetz-dev-token

GRAPH_API_VERSION=v20.0
PORT=3000

# Postgres compartido entre el bot y la API de la app (login, clientes,
# mascotas, reservas). Sin esta variable, el bot sigue funcionando en modo
# memoria (como antes) pero /api/* responde 503 y nada se persiste.
# En Render: se llena sola al enlazar una base de datos Postgres al servicio.
DATABASE_URL=

# WhatsApp Flows — dejan marcar varios servicios o varios días a la vez, en
# una sola pantalla con checkboxes reales, en vez de tocar una fila y esperar
# a que el bot mande la lista actualizada para tocar la siguiente. Sin estas
# dos variables el bot sigue funcionando exactamente igual que antes (listas
# de toque-uno-a-la-vez) — actívalas solo cuando publiques los Flows en el
# WhatsApp Manager de Meta. Instrucciones completas + los JSON para importar:
# whatsapp/flows/*.json y docs/whatsapp-flows-setup.md
WHATSAPP_FLOW_ID_SERVICES=
WHATSAPP_FLOW_ID_PASEO_DAYS=
