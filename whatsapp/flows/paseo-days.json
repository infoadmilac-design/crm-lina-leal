{
  "version": "7.3",
  "screens": [
    {
      "id": "DAYS",
      "title": "Días de paseo",
      "data": {
        "selected": {
          "type": "array",
          "items": { "type": "string" },
          "__example__": ["0", "2", "4"]
        }
      },
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "¿Qué días sale a pasear?"
          },
          {
            "type": "TextBody",
            "text": "Marca todos los días que quieras, a la vez. Entre más días elijas, más baja el precio por cada paseo."
          },
          {
            "type": "Form",
            "name": "form",
            "children": [
              {
                "type": "CheckboxGroup",
                "name": "days",
                "label": "Días",
                "required": true,
                "min-selected-items": 1,
                "init-value": "${data.selected}",
                "data-source": [
                  { "id": "0", "title": "Lunes" },
                  { "id": "1", "title": "Martes" },
                  { "id": "2", "title": "Miércoles" },
                  { "id": "3", "title": "Jueves" },
                  { "id": "4", "title": "Viernes" },
                  { "id": "5", "title": "Sábado" },
                  { "id": "6", "title": "Domingo" }
                ]
              }
            ]
          },
          {
            "type": "Footer",
            "label": "Continuar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "selected": "${form.days}"
              }
            }
          }
        ]
      }
    }
  ]
}
